# Copy to .env for local development. In production, set these as real environment variables / secrets.
NODE_ENV=development
PORT=3000
# Local PostgreSQL:
DATABASE_URL=postgresql://mt:mt@localhost:5432/mt_tablet
# Supabase: Project → Connect → "Session pooler" connection string, with your database password filled in.
# If the password has symbols like @ # / : ? %, replace them: @ → %40, # → %23, / → %2F, : → %3A, ? → %3F, % → %25
# DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Encryption to the database: off | require | verify. Leave unset: it is on automatically for hosted databases.
# DATABASE_SSL=
# DATABASE_CA_FILE=   (for DATABASE_SSL=verify, e.g. Supabase's downloadable CA certificate)
DATABASE_POOL_MAX=10

# Question bank: GenPrep's Supabase project, read-only. Leave empty to use the built-in sample questions.
# Use the Session pooler address with the read-only role mt_reader (see docs/OPERATIONS.md).
GENPREP_DATABASE_URL=

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
STAFF_REFRESH_TTL_DAYS=7
STUDENT_REFRESH_TTL_DAYS=30

# Comma-separated admin-portal origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Students may only sign in on the tablet assigned to them (recommended once tablets are enrolled).
ENFORCE_TABLET_BINDING=false
# Set to true when the API runs behind a reverse proxy / load balancer.
TRUST_PROXY=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
ENABLE_SWAGGER=true
STORAGE_DIR=./storage

# Used only by `npm run seed`.
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=change-this-strong-password
SEED_DEMO=false
